# Google OAuth Configuration
# ⚠️ IMPORTANT: Each developer must create their own Google OAuth credentials
# DO NOT share credentials with other developers
# DO NOT commit this section with real values to Git (it's in .gitignore)
# 
# SETUP INSTRUCTIONS FOR YOUR OWN CREDENTIALS:
# 1. Go to https://console.cloud.google.com/
# 2. Create a NEW project (e.g., "Farmers Mall - YourName")
# 3. Enable the Google+ API
# 4. Set up OAuth consent screen
# 5. Go to "Credentials" → "Create Credentials" → "OAuth 2.0 Client ID"
# 6. Choose "Web application"
# 7. Add authorized redirect URIs (both required for local dev):
#    - http://localhost/The-Farmers-Mall/auth/google-callback.php
#    - http://127.0.0.1/The-Farmers-Mall/auth/google-callback.php
# 8. For production, add: https://yourdomain.com/The-Farmers-Mall/auth/google-callback.php
# 9. Copy your Client ID and Client Secret
# 10. Fill in YOUR credentials below (never share these with others)
# 11. For troubleshooting, visit: http://localhost/The-Farmers-Mall/google-oauth-diagnostic.php

GOOGLE_CLIENT_ID=YOUR_OWN_GOOGLE_CLIENT_ID_HERE
GOOGLE_CLIENT_SECRET=YOUR_OWN_GOOGLE_CLIENT_SECRET_HERE

# Payment Gateway Configuration
# ⚠️ IMPORTANT: Get your own credentials from PayPal and Paymongo
# DO NOT commit real credentials to Git
# 
# PAYPAL SETUP:
# 1. Go to https://developer.paypal.com/
# 2. Create a REST API app
# 3. Copy Client ID and Secret
# 4. For testing: use sandbox credentials
# 5. For production: use live credentials and set PAYPAL_MODE=live
#
# GCASH/PAYMONGO SETUP:
# 1. Go to https://paymongo.com/
# 2. Sign up for business account
# 3. Get API keys from Dashboard > Developers
# 4. For testing: use test keys (sk_test_*, pk_test_*)
# 5. For production: use live keys (sk_live_*, pk_live_*)

# PayPal Configuration
PAYPAL_ENABLED=true
